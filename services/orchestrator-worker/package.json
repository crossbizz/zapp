{
  "name": "@zapp/orchestrator-worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./session": {
      "types": "./dist/session/index.d.ts",
      "default": "./dist/session/index.js"
    }
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "start:verification": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run --exclude test/integration/ar9-postgres-worker.test.ts --exclude test/integration/autonomous.test.ts --exclude test/integration/fix.test.ts --exclude test/integration/verifier.test.ts --exclude test/integration/repair.test.ts",
    "test:integration": "vitest run test/integration/ar9-postgres-worker.test.ts test/integration/autonomous.test.ts test/integration/fix.test.ts test/integration/verifier.test.ts test/integration/repair.test.ts --no-file-parallelism"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1103.0",
    "@temporalio/activity": "1.22.0",
    "@temporalio/client": "1.22.0",
    "@temporalio/worker": "1.22.0",
    "@temporalio/workflow": "1.22.0",
    "@zapp/agent-policies": "workspace:*",
    "@zapp/agent-tools": "workspace:*",
    "@zapp/contracts": "workspace:*",
    "@zapp/config": "workspace:*",
    "@zapp/db": "workspace:*",
    "@zapp/model-gateway": "workspace:*",
    "@zapp/planning-engine": "workspace:*",
    "@zapp/project-adapters": "workspace:*",
    "@zapp/verification-engine": "workspace:*",
    "drizzle-orm": "^0.45.2",
    "zod": "^3.23.8",
    "zod-to-json-schema": "3.25.2"
  },
  "devDependencies": {
    "@temporalio/testing": "1.22.0",
    "@types/node": "^22.9.0",
    "@zapp/workspace-runtime": "workspace:*",
    "postgres": "^3.4.9",
    "vitest": "^3.2.7"
  }
}
