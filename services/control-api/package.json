{
  "name": "@zapp/control-api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "start": "node --enable-source-maps dist/server.js"
  },
  "dependencies": {
    "@zapp/config": "workspace:*",
    "@zapp/contracts": "workspace:*",
    "@zapp/db": "workspace:*",
    "fastify": "^5.11.2",
    "fastify-plugin": "^5.0.1",
    "fastify-type-provider-zod": "^4.0.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "pino-pretty": "^13.1.3",
    "vitest": "^2.1.4"
  }
}
