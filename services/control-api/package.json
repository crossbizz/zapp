{
  "name": "@zapp/control-api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:integration": "vitest run --dir test/integration --no-file-parallelism",
    "dev": "tsx watch --env-file-if-exists=../../.env src/server.ts",
    "start": "node --enable-source-maps dist/server.js"
  },
  "dependencies": {
    "@zapp/config": "workspace:*",
    "@zapp/contracts": "workspace:*",
    "@zapp/db": "workspace:*",
    "fastify": "^5.11.2",
    "fastify-plugin": "^5.0.1",
    "fastify-type-provider-zod": "^4.0.2",
    "jose": "^5.10.0",
    "stytch": "^14.2.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "drizzle-orm": "^0.45.2",
    "pino-pretty": "^13.1.3",
    "tsx": "^4.23.5",
    "vitest": "^2.1.4"
  }
}
