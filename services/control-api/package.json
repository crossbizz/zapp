{
  "name": "@zapp/control-api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:integration": "vitest run --dir test/integration --no-file-parallelism",
    "test:gate5": "node --env-file-if-exists=../../.env --env-file-if-exists=../../.env.local.forgejo ./node_modules/vitest/vitest.mjs run --config vitest.gate5.config.ts --no-file-parallelism",
    "test:isolation": "vitest run --dir test/integration --no-file-parallelism tenant-isolation",
    "dev": "tsx watch --env-file-if-exists=../../.env src/server.ts",
    "start": "node --enable-source-maps dist/server.js"
  },
  "dependencies": {
    "@fastify/swagger": "^9.8.1",
    "@fastify/websocket": "11.3.0",
    "@zapp/config": "workspace:*",
    "@zapp/contracts": "workspace:*",
    "@zapp/db": "workspace:*",
    "@zapp/sandbox-service": "workspace:*",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.11.2",
    "fastify-plugin": "^5.0.1",
    "fastify-type-provider-zod": "^4.0.2",
    "ioredis": "^6.0.0",
    "jose": "^5.10.0",
    "stytch": "^14.2.0",
    "ws": "8.21.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "@types/ws": "8.18.1",
    "@zapp/git-service": "workspace:*",
    "openapi-typescript": "^7.13.0",
    "pino-pretty": "^13.1.3",
    "tsx": "^4.23.5",
    "typescript": "^5.6.3",
    "vitest": "^3.2.7"
  }
}
