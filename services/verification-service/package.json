{
  "name": "@zapp/verification-service",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:integration": "vitest run --dir test/integration --no-file-parallelism"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1103.0",
    "@zapp/config": "workspace:*",
    "@zapp/contracts": "workspace:*",
    "@zapp/db": "workspace:*",
    "@zapp/model-gateway": "workspace:*",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.11.2",
    "fastify-type-provider-zod": "^4.0.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/node": "^22.9.0",
    "pino-pretty": "^13.1.3",
    "vitest": "^3.2.7"
  }
}
