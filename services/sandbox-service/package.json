{
  "name": "@zapp/sandbox-service",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./app": {
      "types": "./dist/compose.d.ts",
      "default": "./dist/compose.js"
    },
    "./provider/modal": {
      "types": "./dist/provider/modal.d.ts",
      "default": "./dist/provider/modal.js"
    },
    "./provider-types": {
      "types": "./dist/provider/types.d.ts",
      "default": "./dist/provider/types.js"
    },
    "./preview-tokens": {
      "types": "./dist/preview/tokens.d.ts",
      "default": "./dist/preview/tokens.js"
    },
    "./preview-transport": {
      "types": "./dist/preview/transport.d.ts",
      "default": "./dist/preview/transport.js"
    },
    "./state/postgres": {
      "types": "./dist/state/postgres.d.ts",
      "default": "./dist/state/postgres.js"
    }
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "dev": "tsx watch src/server.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "start": "node dist/server.js",
    "test": "vitest run"
  },
  "dependencies": {
    "@fastify/websocket": "^11.2.0",
    "@node-rs/argon2": "2.0.2",
    "@zapp/config": "workspace:*",
    "@zapp/contracts": "workspace:*",
    "@zapp/db": "workspace:*",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.11.2",
    "fastify-type-provider-zod": "^4.0.2",
    "modal": "0.9.0",
    "ws": "^8.21.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/node": "22.20.1",
    "@types/ws": "^8.18.1",
    "postgres": "^3.4.9",
    "tsx": "^4.23.5",
    "vitest": "3.2.7"
  }
}
