{
  "name": "@zapp/git-service",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "backup": "tsx --env-file-if-exists=../../.env.local.forgejo scripts/backup.ts nightly",
    "backup:restore": "tsx --env-file-if-exists=../../.env.local.forgejo scripts/backup.ts restore",
    "backup:restore-cleanup": "tsx --env-file-if-exists=../../.env.local.forgejo scripts/backup.ts restore-cleanup",
    "backup:restore-drill": "tsx --env-file-if-exists=../../.env.local.forgejo scripts/backup.ts restore-drill",
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:integration": "node --env-file-if-exists=../../.env.local.forgejo ./node_modules/vitest/vitest.mjs run --dir test/integration --no-file-parallelism",
    "bootstrap": "tsx --env-file-if-exists=../../.env.local.forgejo scripts/bootstrap.ts",
    "dev": "tsx watch --env-file-if-exists=../../.env --env-file-if-exists=../../.env.local.forgejo src/server.ts",
    "start": "node --enable-source-maps dist/server.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1103.0",
    "@zapp/config": "workspace:*",
    "@zapp/contracts": "workspace:*",
    "@zapp/db": "workspace:*",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.11.2",
    "fastify-plugin": "^5.0.1",
    "fastify-type-provider-zod": "^4.0.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "pino-pretty": "^13.1.3",
    "tsx": "^4.23.5",
    "vitest": "^3.2.7"
  }
}
