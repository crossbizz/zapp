{
  "name": "@zapp/release-service",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./app": {
      "types": "./dist/app.d.ts",
      "default": "./dist/app.js"
    },
    "./lifecycle": {
      "types": "./dist/lifecycle.d.ts",
      "default": "./dist/lifecycle.js"
    },
    "./history": {
      "types": "./dist/history.d.ts",
      "default": "./dist/history.js"
    },
    "./records": {
      "types": "./dist/release/create.d.ts",
      "default": "./dist/release/create.js"
    }
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:integration": "vitest run --root ../.. --config vitest.config.ts --project release-e2e"
  },
  "dependencies": {
    "@temporalio/workflow": "1.22.0",
    "@zapp/config": "workspace:*",
    "@zapp/contracts": "workspace:*",
    "@zapp/db": "workspace:*",
    "@zapp/verification-engine": "workspace:*",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.11.2",
    "fastify-type-provider-zod": "^4.0.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "typescript": "^5.6.3",
    "vitest": "^3.2.7"
  }
}
