{
  "name": "@zapp/model-gateway",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "dev": "tsx watch --env-file-if-exists=../../.env --import ./src/instrumentation.ts src/server.ts",
    "start": "node --enable-source-maps --import ./dist/instrumentation.js dist/server.js"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "4.0.29",
    "@ai-sdk/google": "4.0.33",
    "@ai-sdk/openai": "4.0.29",
    "@ai-sdk/openai-compatible": "3.0.22",
    "@opentelemetry/api": "1.9.1",
    "@zapp/config": "workspace:*",
    "@zapp/contracts": "workspace:*",
    "ai": "7.0.51",
    "fastify": "^5.11.2",
    "fastify-plugin": "^5.0.1",
    "fastify-type-provider-zod": "^4.0.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "pino-pretty": "^13.1.3",
    "tsx": "^4.23.5",
    "vitest": "^3.2.7"
  }
}
