{
  "name": "@zapp/workspace-agent",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/main.d.ts",
      "default": "./dist/main.js"
    }
  },
  "scripts": {
    "build": "rm -rf dist && node scripts/build-native.mjs && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "postinstall": "node scripts/ensure-node-pty-helper.mjs"
  },
  "dependencies": {
    "@vscode/ripgrep": "^1.17.0",
    "@zapp/contracts": "workspace:*",
    "@zapp/workspace-runtime": "workspace:*",
    "execa": "8.0.1",
    "fastify": "5.11.2",
    "node-pty": "1.1.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/node": "22.20.1",
    "vitest": "3.2.7"
  }
}
