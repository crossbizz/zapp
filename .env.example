# zapp.build — environment template.
#
#   cp .env.example .env      (scripts/dev-up.sh does this for you)
#
# Committed file: NAMES ONLY. Every third-party value here is a placeholder —
# real keys live in .env, which is gitignored and must never be committed.
# The infra values below match the local stack in
# infra/docker/docker-compose.dev.yml; see docs/dev-setup.md to change ports.
# Later plans add their own variables — keep this file in sync as they land.
#
# Every placeholder is spelled `replace-me`, and that spelling is load-bearing
# in two places: `scripts/dev-up.sh` substitutes the four generated secrets by
# variable name, and every credential-gated test suite treats a `replace-me`
# value as *absent* rather than as configured
# (services/control-api/test/support/credentials.ts). A placeholder that looked
# like a real value is how the Stytch integration suite came to pass against a
# project that does not exist — so if you add a variable here, give it a
# `replace-me` placeholder or leave it empty. Never a plausible-looking one.

# ---------------------------------------------------------------------------
# Runtime
# ---------------------------------------------------------------------------
NODE_ENV=development
LOG_LEVEL=info
# Public origins. The control API builds its OAuth callback and its device
# verification URI from API_BASE_URL rather than from the Host header, and sends
# a signed-in browser to APP_BASE_URL (plan 02 CP-2).
APP_BASE_URL=http://localhost:3000
API_BASE_URL=http://localhost:4000
PREVIEW_BASE_DOMAIN=preview.localhost
PREVIEW_SHARE_SIGNING_KEY=replace-me
PREVIEW_SHARE_KEY_VERSION=1
SANDBOX_SERVICE_URL=http://localhost:4400

# ---------------------------------------------------------------------------
# Datastores (local docker-compose; Neon + Upstash in staging/prod)
# ---------------------------------------------------------------------------
DATABASE_URL=postgres://zapp:zapp@localhost:5432/zapp
REDIS_URL=redis://localhost:6379

# ---------------------------------------------------------------------------
# Artifact storage (local MinIO; Cloudflare R2 in staging/prod)
# ---------------------------------------------------------------------------
ARTIFACT_ENDPOINT=http://localhost:9000
ARTIFACT_KEY=minioadmin
ARTIFACT_SECRET=minioadmin
ARTIFACT_BUCKET=zapp-artifacts
ARTIFACT_REGION=us-east-1

# ---------------------------------------------------------------------------
# Internal Git (Forgejo)
# ---------------------------------------------------------------------------
FORGEJO_URL=http://localhost:3300
# Minted by scripts/dev-up.sh into .env.local.forgejo. Leave this placeholder
# alone: the git-service scripts that need the token load that file themselves
# (`--env-file-if-exists=../../.env.local.forgejo` in services/git-service/
# package.json), so there is nothing to copy here, and copying it is worse than
# leaving it.
#
# A placeholder rather than an empty value, and the difference matters: node's
# --env-file never overrides a variable that is already in the process
# environment, so a shell that has `source`d this file shadows the real token in
# .env.local.forgejo for anything started afterwards — including
# `pnpm --filter @zapp/git-service test:integration`, which is the only place
# the cross-repo denial property is checked. An empty value is indistinguishable
# from never having set one; `replace-me` is not, and the suite's guard says so
# by name (services/git-service/test/integration/helpers.ts).
FORGEJO_ADMIN_TOKEN=replace-me
# How long one Forgejo API call may take. Deliberately half of the control
# plane's GIT_CREATE_DEADLINE_MS (10s), because that deadline is measured while a
# PostgreSQL transaction is held open: this service has to give up first.
FORGEJO_TIMEOUT_MS=5000
# Git bundle creation can legitimately exceed the API request deadline for
# large repositories. Restore commands have a separate, shorter budget and
# must finish before their five-minute repository credential expires.
GIT_BACKUP_COMMAND_DEADLINE_MS=900000
GIT_RESTORE_COMMAND_DEADLINE_MS=240000
# Where services/git-service answers. Only the control plane reads this, and only
# it and the git service ever hold FORGEJO_ADMIN_TOKEN.
#
# Empty is allowed in development only: the control plane then falls back to
# naming repositories without creating them, which is what lets `pnpm dev` create
# projects with no git service running. Outside development an empty value is a
# refusal to start — see services/control-api/src/git/client.ts.
GIT_SERVICE_URL=http://localhost:4500

# ---------------------------------------------------------------------------
# Temporal (local auto-setup server; Temporal Cloud in staging/prod)
# ---------------------------------------------------------------------------
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default

# ---------------------------------------------------------------------------
# AWS SQS / SNS / SES — LocalStack values locally; real IAM creds in the cloud.
# Leave AWS_ENDPOINT_URL empty outside local dev to use real AWS endpoints.
# ---------------------------------------------------------------------------
AWS_REGION=us-east-1
AWS_ENDPOINT_URL=http://localhost:4566
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
SQS_GITHUB_WEBHOOK_QUEUE_NAME=zapp-github-webhooks
SQS_NOTIFICATION_QUEUE_NAME=zapp-notifications
SES_NOTIFICATION_SOURCE=dev@zapp.local
SNS_NOTIFICATION_TOPIC_ARN=arn:aws:sns:us-east-1:000000000000:zapp-notifications

# GitHub App (platform-owned). Keep real values in untracked .env only.
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
GITHUB_WEBHOOK_SECRET=
GITHUB_API_BASE_URL=

# ---------------------------------------------------------------------------
# Identity (Stytch B2B) — test-project credentials, never production ones
# ---------------------------------------------------------------------------
# `project-test-…` in a real project; the placeholder keeps the prefix because
# the adapter picks the Stytch host from it, and says `replace-me` for the rest
# because the shape it used to have — a nil UUID — read as a real project id.
STYTCH_PROJECT_ID=project-test-replace-me
STYTCH_SECRET=replace-me
STYTCH_PUBLIC_TOKEN=public-token-test-replace-me

# ---------------------------------------------------------------------------
# Platform secrets — generate with `openssl rand -hex 32`, never reuse in prod
# ---------------------------------------------------------------------------
SESSION_JWT_SECRET=replace-me
# Set during rotation only; accepted for verification alongside the current key.
SESSION_JWT_SECRET_PREVIOUS=
SERVICE_TOKEN_SECRET=replace-me
# Set during rotation only; accepted for verification alongside the current key.
SERVICE_TOKEN_SECRET_PREVIOUS=
# Keys the request digest stored with durable run intent. Every control-api
# replica in one environment must share it; there is no production default.
# Do not rotate it while durable run rows can still be retried: rotation needs
# a dual-key/versioned migration or deliberate cleanup of those rows first.
RUN_INTENT_HMAC_SECRET=replace-me
# The secrets vault master key (plan 02 CP-7) is the one value here that is NOT
# hex: it is base64 of exactly 32 bytes (`openssl rand -base64 32`). Anything
# else fails at boot naming the variable, and there is no default by design — a
# process that invented a key would encrypt secrets nothing else can read, and
# one that fell back to a published default would encrypt them so that everybody
# can. It loads before the server listens, so a missing or malformed value is a
# refusal to start rather than a vault that quietly opens.
#
# Staging/prod hold a real generated secret here, never this committed
# placeholder: every stored secret is wrapped under this key, so a shared value
# hands over the vault and a lost one strands its contents.
SECRETS_MASTER_KEY=replace-me-with-openssl-rand-base64-32
# The rotation pair, both optional — leave them as shipped unless you are
# rotating: an empty previous key at version 1 is the steady state, which is what
# makes a rotation a value change rather than a schema change.
#
# To rotate, the new key becomes SECRETS_MASTER_KEY, the version moves forward,
# and the outgoing key goes here — secrets wrapped under it stay readable at
# `version - 1`, one generation back by construction, while a sweep re-wraps the
# data keys. No secret *value* is re-encrypted; that is the point of the
# envelope. Empty this again once `secret_metadata.key_version` shows no rows
# left at the old generation.
SECRETS_PREVIOUS_MASTER_KEY=
# Which generation SECRETS_MASTER_KEY is; defaults to 1. A previous key requires
# at least 2 and is refused otherwise — version 1 has nothing before it, so that
# pairing is a forgotten version bump, which would wrap new secrets under the
# generation being retired.
SECRETS_MASTER_KEY_VERSION=1

# ---------------------------------------------------------------------------
# Sandboxes (Modal) — no Modal SDK usage outside services/sandbox-service
# ---------------------------------------------------------------------------
MODAL_TOKEN_ID=replace-me
MODAL_TOKEN_SECRET=replace-me
MODAL_ENVIRONMENT=dev
# Which profile in `~/.modal.toml` to act as. Nothing in zapp reads this — the
# Modal SDK does — so it is named here only because a machine that has run
# `modal setup` for more than one account needs to say which one this stack is
# talking to. Empty is the shipped default: leave the choice to Modal's own
# config, which is right when there is one profile. Not a credential, and not one
# of the resource/network profiles in plan 03 — those are per-workspace, not
# per-machine.
MODAL_PROFILE=

# ---------------------------------------------------------------------------
# Model providers — only services/model-gateway reads these
# ---------------------------------------------------------------------------
ANTHROPIC_API_KEY=replace-me
OPENAI_API_KEY=replace-me
GEMINI_API_KEY=replace-me
# Optional fourth provider: an OpenAI-compatible endpoint.
OPENAI_COMPATIBLE_API_KEY=replace-me
OPENAI_COMPATIBLE_BASE_URL=
MODEL_GATEWAY_PORT=4100
MODEL_GATEWAY_URL=http://127.0.0.1:4100
CONTROL_API_URL=http://127.0.0.1:4000

# ---------------------------------------------------------------------------
# Staff support console — user IDs only, never emails or credentials
# ---------------------------------------------------------------------------
SUPPORT_ADMIN_ENABLED=false
SUPPORT_ADMIN_USER_IDS=

# ---------------------------------------------------------------------------
# Billing (Stripe subscriptions + Flexprice metering/credits)
# ---------------------------------------------------------------------------
PLATFORM_BILLING_STRIPE_SECRET_KEY=sk_test_replace-me
PLATFORM_BILLING_STRIPE_WEBHOOK_SECRET=whsec_replace-me
STRIPE_PLAN_PRICE_IDS_JSON=
STRIPE_CREDIT_PACK_PRICE_IDS_JSON=
STRIPE_PLAN_MONTHLY_UNIT_AMOUNTS_CENTS_JSON=
FLEXPRICE_API_KEY=replace-me
FLEXPRICE_BASE_URL=https://api.cloud.flexprice.io/v1
FLEXPRICE_STRIPE_WEBHOOK_URL=

# ---------------------------------------------------------------------------
# Observability (OpenTelemetry -> Grafana Cloud) + product analytics (PostHog)
# ---------------------------------------------------------------------------
GRAFANA_OTLP_ENDPOINT=https://otlp-gateway-prod-us-east-0.grafana.net/otlp
GRAFANA_OTLP_TOKEN=replace-me
# Dedicated random credential configured as the Grafana Alerting webhook Bearer token.
GRAFANA_ALERT_WEBHOOK_SECRET=
NEXT_PUBLIC_FARO_URL=
NEXT_PUBLIC_ZAPP_ENV=development
NEXT_PUBLIC_ZAPP_RELEASE=
NEXT_PUBLIC_FARO_BUNDLE_ID=
GRAFANA_FARO_SOURCEMAP_ENDPOINT=
GRAFANA_FARO_WEB_APP_ID=
GRAFANA_FARO_DESKTOP_APP_ID=
GRAFANA_FARO_STACK_ID=
GRAFANA_FARO_SOURCEMAP_TOKEN=
POSTHOG_KEY=phc_replace-me
POSTHOG_HOST=https://us.i.posthog.com
# Browser-safe PostHog project configuration for WEB-3 feature flags. Leave
# blank to keep every home feature at its fail-closed default.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=
