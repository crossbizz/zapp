#!/usr/bin/env bash
# zapp local verification gate.
#
# GitHub Actions is intentionally disabled (private repo, metered minutes, no
# spending limit). This hook is the gate. It runs the same suites CI ran.
#
# Source of truth: scripts/git-hooks/pre-push.local — installed into
# .git/hooks/ by scripts/dev-up.sh (.git/hooks is untracked, so a fresh clone
# has no gate until dev-up runs). Edit the tracked copy, then re-run dev-up.
#
# Turbo caches per package, so unchanged packages replay instantly — in practice
# this only runs what you actually touched. test:isolation and test:gate5 run
# outside turbo and always execute for real.
#
# Fails closed, structurally: it exports CI, which arms the refuse-to-skip
# guards inside the integration/isolation suites themselves — a suite whose
# configuration is missing THROWS instead of skipping, so "green because
# nothing ran" cannot happen here any more than it could in CI. (It did happen
# on 2026-08-07: the hook ran verify without the dev-stack env, 53/54 isolation
# tests skipped, and the push sailed through.) The pg_isready probe below is
# only a faster, clearer version of the same refusal.
# Emergency bypass: ZAPP_SKIP_VERIFY=1 git push (announce it in your report).
set -euo pipefail

remote_ref_is_main=0
# The `|| [ -n … ]` guard is load-bearing: the gstack-managed wrapper pipes the
# ref list via `printf '%s'` with NO trailing newline, and a bare `read` returns
# non-zero on an unterminated final line — the loop body would never run and the
# gate would silently disarm (that exact miss also shipped on 2026-08-07).
while read -r _local_ref _local_sha remote_ref _remote_sha || [ -n "${_local_ref:-}" ]; do
  case "$remote_ref" in refs/heads/main) remote_ref_is_main=1 ;; esac
done
[ "$remote_ref_is_main" -eq 1 ] || exit 0

if [ "${ZAPP_SKIP_VERIFY:-0}" = "1" ]; then
  echo "zapp: VERIFY BYPASSED via ZAPP_SKIP_VERIFY=1 — main is unverified." >&2
  exit 0
fi

repo_root="$(git rev-parse --show-toplevel)"
cd "$repo_root"

if ! pg_isready -h localhost -p 5432 -q 2>/dev/null; then
  echo "zapp: dev stack is not running — integration + isolation suites would skip," >&2
  echo "      and a skip is not a pass. Run ./scripts/dev-up.sh first." >&2
  exit 1
fi

# Load the dev-stack env the way ci.yml's `env:` blocks did: .env is the
# catalogue (dev-up.sh seeds it), .env.local.forgejo is written by dev-up.sh
# and is fresher for FORGEJO_* (sourced second, so it wins). Turbo's strict
# envMode still filters what each task actually sees.
set -a
[ -f .env ] && . ./.env
[ -f .env.local.forgejo ] && . ./.env.local.forgejo
set +a

# Pin the gate to the LOCAL compose stack, whatever .env currently says. These
# are docker-compose.dev.yml literals, pinned here for the reason dev-up.sh
# pins the MinIO literals. .env is live developer config, not a hermetic test
# env — on 2026-08-07 it held a Neon DATABASE_URL, so the gate ran every suite
# against a shared remote database where concurrent agents' runs truncate each
# other's rows: deadlocks, vanishing orgs, and a different failure set every
# run. The pg_isready probe above guards localhost, so the suites must test
# localhost — a guard that probes one database while the tests hit another is
# no guard at all.
export DATABASE_URL="postgres://zapp:zapp@localhost:${ZAPP_POSTGRES_PORT:-5432}/zapp"
export REDIS_URL="redis://localhost:${ZAPP_REDIS_PORT:-6379}"

# This hook is the CI now; arm the suites' refuse-to-skip guards.
export CI="${CI:-zapp-prepush}"

echo "zapp: running pnpm verify before pushing to main…" >&2
pnpm verify
