{
  "name": "@zapp/ui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./tokens.css": "./dist/tokens.css"
  },
  "scripts": {
    "build": "pnpm build:package && pnpm build:vite-consumer",
    "build:package": "rm -rf dist && tsc -p tsconfig.build.json && cp src/tokens.css dist/tokens.css",
    "build:storybook": "storybook build --output-dir storybook-static",
    "build:vite-consumer": "vite build examples/vite",
    "build:vite-smoke": "pnpm build:package && pnpm build:vite-consumer",
    "lint": "eslint \"src/**/*.{ts,tsx}\" \"test/**/*.{ts,tsx}\" \".storybook/**/*.ts\" \"examples/vite/src/**/*.{ts,tsx}\" examples/vite/vite.config.ts vitest.config.ts",
    "test": "pnpm test:unit && pnpm test:a11y",
    "test:a11y": "pnpm build:storybook && concurrently --kill-others --success first --names storybook,axe \"http-server storybook-static --port 6006 --host 127.0.0.1 --silent\" \"wait-on http://127.0.0.1:6006 && test-storybook --url http://127.0.0.1:6006\"",
    "test:unit": "vitest run",
    "typecheck": "pnpm build:package && tsc --noEmit"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-toast": "^1.2.15",
    "@radix-ui/react-tooltip": "^1.2.8",
    "clsx": "^2.1.1",
    "lucide-react": "^0.468.0",
    "react-markdown": "^10.1.0",
    "tailwindcss": "^4.1.18"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "8.6.15",
    "@storybook/addon-essentials": "8.6.15",
    "@storybook/react": "8.6.15",
    "@storybook/react-vite": "8.6.15",
    "@storybook/test": "8.6.15",
    "@storybook/test-runner": "^0.23.0",
    "@tailwindcss/vite": "^4.1.18",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "^22.9.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "axe-playwright": "^2.1.0",
    "concurrently": "^9.1.2",
    "http-server": "^14.1.1",
    "jsdom": "^26.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "storybook": "8.6.15",
    "typescript": "^5.6.3",
    "vite": "^6.1.0",
    "vitest": "^3.2.7",
    "wait-on": "^8.0.1"
  }
}
