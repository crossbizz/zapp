{
  "name": "zapp",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "pnpm": {
    "overrides": {
      "@electron/rebuild": "4.2.0"
    }
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "pnpm lint:architecture && turbo run lint",
    "lint:architecture": "pnpm test:architecture && node scripts/check-model-provider-boundary.mjs",
    "test:architecture": "node --test scripts/model-provider-boundary.test.mjs",
    "test:validation": "node --test validation/benchmarks/*.test.mjs validation/exit-criteria/*.test.mjs validation/go-no-go/*.test.mjs",
    "validation:benchmarks": "node validation/benchmarks/validate.mjs",
    "validation:exit-criteria": "node validation/exit-criteria/validate.mjs",
    "validation:go-no-go-policy": "node validation/go-no-go/evaluate.mjs",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:integration": "turbo run test:integration",
    "modal:publish": "pnpm --filter @zapp/modal-infra modal:publish",
    "modal:smoke": "pnpm --filter @zapp/modal-infra modal:smoke",
    "db:generate": "pnpm --filter @zapp/db db:generate",
    "db:migrate": "pnpm --filter @zapp/db db:migrate",
    "format": "prettier --write .",
    "verify": "pnpm turbo run lint typecheck build test --continue --filter=!@zapp/desktop && pnpm turbo run test:integration --filter=!@zapp/desktop --concurrency=1 && pnpm --filter @zapp/control-api run test:isolation && pnpm --filter @zapp/control-api run test:gate5",
    "verify:cold": "rm -rf packages/*/dist services/*/dist .turbo && pnpm verify"
  },
  "devDependencies": {
    "@zapp/contracts": "workspace:*",
    "eslint": "9.39.5",
    "jscpd": "4.2.5",
    "knip": "6.14.2",
    "prettier": "^3.3.3",
    "turbo": "^2.3.0",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.14.0",
    "vitest": "^3.2.7"
  }
}
