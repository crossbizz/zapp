{
  "name": "zapp",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "pnpm lint:architecture && turbo run lint",
    "lint:architecture": "pnpm test:architecture && node scripts/check-model-provider-boundary.mjs",
    "test:architecture": "node --test scripts/model-provider-boundary.test.mjs",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:integration": "turbo run test:integration",
    "db:generate": "pnpm --filter @zapp/db db:generate",
    "db:migrate": "pnpm --filter @zapp/db db:migrate",
    "format": "prettier --write .",
    "verify": "pnpm turbo run lint typecheck build test --continue --filter=!@zapp/desktop && pnpm turbo run test:integration --filter=!@zapp/desktop && pnpm --filter @zapp/control-api run test:isolation",
    "verify:cold": "rm -rf packages/*/dist services/*/dist .turbo && pnpm verify"
  },
  "devDependencies": {
    "turbo": "^2.3.0",
    "typescript": "^5.6.3",
    "prettier": "^3.3.3",
    "eslint": "^9.14.0",
    "typescript-eslint": "^8.14.0",
    "vitest": "^3.2.7"
  }
}
