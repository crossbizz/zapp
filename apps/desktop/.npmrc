engine-strict=true

# zapp: electron-forge's `checkSystem` refuses to run under pnpm unless
# `node-linker=hoisted`, `hoist-pattern` or `public-hoist-pattern` is set. It
# probes with `pnpm config get <key>` from this directory, so declaring the
# value here scopes the opt-in to apps/desktop.
#
# `*` is pnpm's own default hoist-pattern, so this satisfies Forge's guard
# without altering the workspace layout: the root install still reads the root
# .npmrc and every other package keeps pnpm's strict isolated node_modules.
hoist-pattern[]=*
