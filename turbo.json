{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": ["tsconfig.base.json", "eslint.config.mjs", ".prettierrc.json"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "lint": {
      // `^build` because typescript-eslint's type-aware rules resolve workspace
      // imports through package entry points (`@zapp/db` -> `dist/`). Without
      // this, a cold checkout lints against unresolved types and reports
      // no-unsafe-* errors that do not reproduce locally, where dist/ survives.
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["build"]
    },
    "test:integration": {
      // `^build` because a service's integration suite imports its workspace
      // dependencies through their package entry points (`@zapp/db` resolves to
      // `dist/`), unlike a package testing its own `src/`. Without this the
      // suite fails on a cold checkout — where nothing has been built — rather
      // than skipping.
      "dependsOn": ["^build"],
      "cache": false,
      // turbo 2 runs tasks in strict env mode: a variable not named here is not
      // in the task's environment at all. A missing name is therefore not a
      // cache-key detail, it is a suite that skips — silently, because every
      // env-gated suite in this repository is written to skip rather than fail
      // when its credential is absent. `FORGEJO_*` were omitted when GIT-2/GIT-3
      // landed, so `turbo run test:integration --filter=@zapp/git-service`
      // reported 15 skipped with both variables exported (GIT review).
      "env": [
        "DATABASE_URL",
        "REDIS_URL",
        "STYTCH_PROJECT_ID",
        "STYTCH_SECRET",
        "FORGEJO_URL",
        "FORGEJO_ADMIN_TOKEN",
        "CI"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
