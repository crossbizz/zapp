{
  "$schema": "https://turbo.build/schema.json",
  // `.env.example` is a global input because two suites parse the shipped
  // template itself rather than a fixture — services/control-api/test/env.test.ts
  // (does it still boot every loader server.ts calls?) and credentials.test.ts
  // (is what it ships still recognised as unconfigured?). Both exist to catch a
  // template edit, and a template edit is exactly what left every task's hash
  // untouched: turbo reported a cache hit and the guards never ran, so CI went
  // green on a template that could not start the control plane. The cost is one
  // full invalidation whenever the template changes, which is rare and is the
  // trade this buys.
  "globalDependencies": [
    "tsconfig.base.json",
    "eslint.config.mjs",
    ".prettierrc.json",
    ".env.example"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "lint": {
      // `^build` because typescript-eslint's type-aware rules resolve workspace
      // imports through package entry points (`@zapp/db` -> `dist/`). Without
      // this, a cold checkout lints against unresolved types and reports
      // no-unsafe-* errors that do not reproduce locally, where dist/ survives.
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["build"]
    },
    "test:integration": {
      // `^build` because a service's integration suite imports its workspace
      // dependencies through their package entry points (`@zapp/db` resolves to
      // `dist/`), unlike a package testing its own `src/`. Without this the
      // suite fails on a cold checkout — where nothing has been built — rather
      // than skipping.
      "dependsOn": ["^build"],
      "cache": false,
      // turbo 2 runs tasks in strict env mode: a variable not named here is not
      // in the task's environment at all. A missing name is therefore not a
      // cache-key detail, it is a suite that skips — silently, because every
      // env-gated suite in this repository is written to skip rather than fail
      // when its credential is absent. `FORGEJO_*` were omitted when GIT-2/GIT-3
      // landed, so `turbo run test:integration --filter=@zapp/git-service`
      // reported 15 skipped with both variables exported (GIT review).
      "env": [
        "DATABASE_URL",
        "REDIS_URL",
        "STYTCH_PROJECT_ID",
        "STYTCH_SECRET",
        "FORGEJO_URL",
        "FORGEJO_ADMIN_TOKEN",
        "CI"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
